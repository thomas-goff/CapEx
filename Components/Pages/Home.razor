@page "/"
@using CapEx.Services.Approvals
@using CapEx.Services.Dashboard
@using CapEx.Services.Requests
@inherits AuthorizedPageBase
@inject IRequestService RequestService
@inject IApprovalWorkflow ApprovalWorkflow
@inject IDashboardMetricsCalculator MetricsCalculator

<PageTitle>Requests - CapEx</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Capital Expenditure Requests</h1>

    <button type="button" class="btn btn-primary" @onclick="OpenNewRequest">
        New request
    </button>
</div>

<DashboardSummary Metrics="_metrics" Viewer="CurrentUser.User" />

@if (_requests is null)
{
    <p class="text-muted">Loading...</p>
}
else if (_requests.Count == 0)
{
    <p class="text-muted">No requests yet.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Title</th>
                <th scope="col" class="text-end">Amount</th>
                <th scope="col">Requested by</th>
                <th scope="col">Raised</th>
                <th scope="col">Status</th>
                <th scope="col">Progress</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in _requests)
            {
                <tr class="request-row" @onclick="() => OpenDetails(request.RequestId)">
                    <td>@request.RequestId</td>
                    <td>@request.Title</td>
                    <td class="text-end">@request.Amount.ToRands()</td>
                    <td>@(request.RequestedByUser?.UserName ?? "-")</td>
                    <td>@request.CreatedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <span class="badge @request.Status.ToBadgeClass()">
                            @request.Status.ToDisplayName()
                        </span>
                    </td>
                    <td class="small text-muted">@ProgressText(request)</td>
                    <td class="text-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary">
                            Open
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<NewRequestModal IsOpen="_isNewRequestOpen"
                 RequestedByUserId="@(CurrentUser.User?.UserId ?? 0)"
                 OnCancelled="CloseNewRequest"
                 OnCreated="HandleRequestCreatedAsync" />

<RequestDetailsModal IsOpen="_selectedRequestId is not null"
                     RequestId="_selectedRequestId"
                     CurrentUser="CurrentUser.User"
                     OnClosed="CloseDetails"
                     OnDecisionRecorded="LoadRequestsAsync" />

@code {
    private IReadOnlyList<Request>? _requests;

    private DashboardMetrics _metrics = DashboardMetrics.Empty;

    private bool _isNewRequestOpen;

    private int? _selectedRequestId;

    protected override async Task OnAuthorizedInitializedAsync()
    {
        await LoadRequestsAsync();
    }

    private async Task LoadRequestsAsync()
    {
        _requests = await RequestService.GetAllAsync();

        _metrics = MetricsCalculator.Calculate(_requests, CurrentUser.User);
    }

    private string ProgressText(Request request)
    {
        var progress = ApprovalWorkflow.GetProgress(request);

        if (progress.NeedsNoApproval)
        {
            return "No approval needed";
        }

        if (request.Status == RequestStatus.Rejected)
        {
            return "Stopped at rejection";
        }

        return $"{progress.CompletedStages} of {progress.TotalStages} approved";
    }

    private void OpenNewRequest() => _isNewRequestOpen = true;

    private void CloseNewRequest() => _isNewRequestOpen = false;

    private void OpenDetails(int requestId) => _selectedRequestId = requestId;

    private void CloseDetails() => _selectedRequestId = null;

    private async Task HandleRequestCreatedAsync(Request created)
    {
        _isNewRequestOpen = false;

        await LoadRequestsAsync();
    }
}
